<script>
(function() {
	var banner = document.getElementById('cookie-consent');
	var accept = document.getElementById('cookie-accept');
	var reject = document.getElementById('cookie-reject');
	var consent = window.__consent;
	if (!banner || !consent) return;

	function show() {
		banner.removeAttribute('hidden');
		// Reflect the current choice so reopening the banner is a settings panel
		// rather than a fresh question with no state.
		banner.setAttribute('data-state', consent.state || 'unset');
	}
	function hide() { banner.setAttribute('hidden', ''); }

	// No stored choice, or a choice that has aged out, means we have to ask.
	if (!consent.state) { show(); }

	if (accept) accept.addEventListener('click', function() {
		consent.accept();
		hide();
	});
	if (reject) reject.addEventListener('click', function() {
		hide();
		consent.reject();
	});

	// Withdrawing has to be as easy as consenting, so the footer link reopens this
	// and both buttons stay live whatever the current state is.
	function openSettings(e) {
		if (e) e.preventDefault();
		show();
		if (accept) accept.focus();
	}
	window.emOpenCookieSettings = openSettings;
	Array.prototype.forEach.call(
		document.querySelectorAll('[data-cookie-settings], a[href="#cookie-settings"]'),
		function(el) { el.addEventListener('click', openSettings); }
	);
	if (location.hash === '#cookie-settings') { openSettings(); }
})();
</script>
