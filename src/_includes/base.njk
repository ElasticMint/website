<!--
	Google Consent Mode v2 + Contentsquare.

	Two different models, deliberately:

	- Google Analytics loads on every page, but with every consent signal denied by
	  default. In that state gtag.js sets no cookies and cannot identify a browser
	  between visits; it sends cookieless pings that still count towards aggregate
	  totals. Accepting sends a `consent update` that turns analytics_storage on.
	  Note this does not buy us GA4's behavioural modelling, which Google only
	  applies above roughly a thousand denied events a day. At our traffic the gain
	  is better aggregate counts, not modelled users.
	- Contentsquare is not covered by Consent Mode and records session behaviour,
	  so it stays hard-blocked and only loads once someone has accepted.

	The ad_* signals stay denied permanently. We run no advertising, so there is
	nothing to grant them for; they are declared because Consent Mode v2 expects
	them to be present.
-->
<script>
(function() {
	var GA_ID = 'G-9D70PLKZQD';
	var STORAGE_KEY = 'cookie_consent';
	// Re-ask roughly every six months rather than treating one click as permanent.
	var CONSENT_MAX_AGE_MS = 182 * 24 * 60 * 60 * 1000;

	// Stored as JSON: {state:'accepted'|'rejected', ts:<epoch ms>}.
	// The previous implementation stored a bare 'accepted'/'rejected' string with no
	// timestamp, under a banner that named only Google Analytics. Contentsquare is now
	// disclosed as well, so that older consent was not given against what we actually
	// do. Those values are ignored on purpose and the banner asks once more.
	function readConsent() {
		var raw = null;
		try { raw = localStorage.getItem(STORAGE_KEY); } catch (e) { return null; }
		if (!raw) return null;
		var parsed;
		try { parsed = JSON.parse(raw); } catch (e) { return null; }
		if (!parsed || (parsed.state !== 'accepted' && parsed.state !== 'rejected')) return null;
		if (!parsed.ts || (Date.now() - parsed.ts) > CONSENT_MAX_AGE_MS) return null;
		return parsed.state;
	}

	function writeConsent(state) {
		try {
			localStorage.setItem(STORAGE_KEY, JSON.stringify({ state: state, ts: Date.now() }));
		} catch (e) {}
	}

	// Google's own snippet pushes to a bare `dataLayer` and leans on it resolving as
	// an implicit global. Naming window explicitly does the same job without that.
	window.dataLayer = window.dataLayer || [];
	function gtag() { window.dataLayer.push(arguments); }
	window.gtag = gtag;

	// Defaults have to be queued before gtag.js is requested, or the first hit goes
	// out under the wrong assumption.
	gtag('consent', 'default', {
		ad_storage: 'denied',
		ad_user_data: 'denied',
		ad_personalization: 'denied',
		analytics_storage: 'denied',
		functionality_storage: 'denied',
		personalization_storage: 'denied',
		security_storage: 'granted'
	});
	gtag('set', 'ads_data_redaction', true);

	var consent = readConsent();
	// The stored choice is read synchronously above, so the update can be queued
	// straight away and there is no need for a wait_for_update delay.
	if (consent === 'accepted') {
		gtag('consent', 'update', { analytics_storage: 'granted' });
	}

	gtag('js', new Date());
	gtag('config', GA_ID);

	var ga = document.createElement('script');
	ga.async = true;
	ga.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
	document.head.appendChild(ga);

	function loadCS() {
		if (window.__csLoaded) return;
		window.__csLoaded = true;
		var s = document.createElement('script');
		s.async = true;
		s.src = 'https://t.contentsquare.net/uxa/05e69e37baf18.js';
		document.head.appendChild(s);
	}
	if (consent === 'accepted') { loadCS(); }

	// Clearing these matters on withdrawal: a consent update stops new cookies being
	// written but leaves any that already exist sitting on the browser.
	function clearGACookies() {
		var names = document.cookie.split(';').map(function(c) {
			return c.split('=')[0].trim();
		}).filter(function(n) {
			return n.indexOf('_ga') === 0 || n.indexOf('_gid') === 0 || n.indexOf('_gcl') === 0;
		});
		var host = location.hostname;
		var domains = ['', host, '.' + host];
		var bare = host.replace(/^www\./, '');
		if (bare !== host) { domains.push(bare, '.' + bare); }
		names.forEach(function(name) {
			domains.forEach(function(d) {
				document.cookie = name + '=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT' +
					(d ? '; domain=' + d : '');
			});
		});
	}

	window.__consent = {
		state: consent,
		accept: function() {
			writeConsent('accepted');
			gtag('consent', 'update', { analytics_storage: 'granted' });
			loadCS();
			this.state = 'accepted';
		},
		reject: function() {
			var wasAccepted = this.state === 'accepted';
			writeConsent('rejected');
			gtag('consent', 'update', { analytics_storage: 'denied' });
			clearGACookies();
			this.state = 'rejected';
			// Contentsquare cannot be unloaded once its script is running, so a genuine
			// withdrawal has to reload the page to actually stop it.
			if (wasAccepted) { location.reload(); }
		}
	};
})();
</script>
