---
layout: base.njk
---
<style>
.blog-article{width:100%;max-width:800px;margin:0 auto;overflow-wrap:break-word}
.blog-article .blog-meta{color:#18cc9c;text-transform:uppercase;letter-spacing:2px;font-size:1.3rem;margin-bottom:0.5rem}
.blog-article .key-takeaways{background:#f4fbf9;border-left:4px solid #18cc9c;border-radius:0.5rem;padding:2rem 2.5rem;margin:3rem 0}
.blog-article .key-takeaways h2{margin-top:0;font-size:2rem}
.blog-article .key-takeaways ul{margin-bottom:0}
.blog-article h2{margin-top:3rem}
.blog-article .post-faqs{border-top:1px solid #e2e8e6;margin-top:4rem;padding-top:1rem}
.blog-article .post-faqs h3{margin-top:2.5rem;font-size:1.9rem}
.blog-article .post-faqs h3:first-of-type{margin-top:1.5rem}
</style>

<div class="row hero">

	<div class="hero-bg row aos-init aos-animate" data-aos="zoom-in" style="background-image: url(/wp-content/uploads/2026/08/hero-team-mid.jpg);">

		<div class="inside">

			<div class="row hero-wrap">

				<div class="hero-content">

					<h4>BLOG</h4>

					<h1>{{ headline }}</h1>

				</div>

			</div>

		</div>

	</div>

	<div class="to-services row">

	</div>

</div>

<div class="row service-intro">

	<div class="inside">

		<article class="make-shorter blog-article aos-init aos-animate" data-aos="fade-up">

			<p class="blog-meta">{{ page.date | dmyDate }}{% if author %} &middot; {{ author }}{% endif %}</p>

			{{ content | safe }}

			{% if faqs and faqs.length %}
			<section class="post-faqs">

				<h2>FAQs</h2>

				{% for f in faqs %}
				<h3>{{ f.q }}</h3>

				<p>{{ f.a | mdInline | safe }}</p>
				{% endfor %}

			</section>
			{% endif %}

		</article>

	</div>

</div>

<div class="row standard-content cta">

	<div class="inside">

		<div class="wrap-content">

			{# Per-post CTA. Each post sets ctaHeading/ctaTitle/ctaButton/ctaUrl in its
			   frontmatter so the ask matches what the reader has just read. Defaults live
			   in blog/blog.11tydata.js; the `or` fallbacks here cover a partial override. #}
			<h4 class="aos-init aos-animate" data-aos="fade-down">{{ ctaHeading or "Next step" }}</h4>

			<h2 class="aos-init aos-animate" data-aos="fade-up">{{ ctaTitle or "Tell us what you are weighing up" }}</h2>

			<a class="aos-init aos-animate button green" data-aos="fade-down" href="{{ ctaUrl or '/contact.html' }}" target="_self">{{ ctaButton or "Get in touch" }}</a>

		</div>

	</div>

</div>
